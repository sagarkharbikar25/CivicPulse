# CivicPulse Server Environment Variables
# Keep variable names locked as defined in 00-setup.md
PORT=5000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHISPER_API_KEY=
LLM_API_KEY=

# Security & CORS configuration
# Change this before deploying. The built-in dev key is rejected in production.
ADMIN_API_KEY=civicpulse-admin-dev-key
# Comma-separated allowlist of browser origins permitted to call the API.
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting (optional overrides)
# Defaults per SECURITY.md: 100 general / 20 submission requests per 15 min.
# RATE_LIMIT_MAX_GENERAL=100
# RATE_LIMIT_MAX_INTAKE=20
# Set RATE_LIMIT_STRICT=true to enforce limits on loopback/non-production too.
# RATE_LIMIT_STRICT=false

# Testing
# Tests are hermetic by default (in-memory store, no live AI calls).
# Opt in to the real Supabase instance with:
# CIVICPULSE_TEST_USE_LIVE_DB=true
